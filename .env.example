# Copy to .env.local and fill in. .env.local is gitignored.

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI provider for photo / URL -> structured recipe extraction.
# Options: "google" (default) or "openai".
#   google → Gemini Flash. Free tier (15 req/min, 1500 req/day, no
#            credit card required). Recommended for personal use.
#   openai → gpt-4o (image) + gpt-4o-mini (URL). Paid only; cents/recipe.
# AI_PROVIDER="google"

# Google AI — get a free key at https://aistudio.google.com/apikey
# (no credit card; just sign in with the same Google account).
# Required when AI_PROVIDER=google.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional — override the Gemini models used for image / URL extraction.
# Defaults to gemini-2.5-flash for both (good vision + free tier on
# fresh AI Studio projects; gemini-2.0-flash sometimes has its free-tier
# quota set to 0 depending on account / region).
# GOOGLE_MODEL="gemini-2.5-flash"
# GOOGLE_URL_MODEL="gemini-2.5-flash"
# Optional — model used for the SECOND (verification) pass that
# cross-checks each extraction for ingredient/step drift. We pick a
# smaller / cheaper / faster model than the primary on purpose: it
# reads the source independently (different biases = catches real
# mistakes), and the primary on Gemini routinely takes 15–30s so
# running it twice would time out. Defaults to gemini-2.5-flash-lite.
# GOOGLE_VERIFY_MODEL="gemini-2.5-flash-lite"

# OpenAI — required only when AI_PROVIDER=openai.
# OPENAI_API_KEY=""
# Optional — override the model used for image-based extraction
# (defaults to gpt-4o; vision quality matters here).
# OPENAI_MODEL="gpt-4o"
# Optional — override the model used for URL-based extraction
# (defaults to gpt-4o-mini; ~17x cheaper, plenty for HTML-on-text).
# OPENAI_URL_MODEL="gpt-4o-mini"
# Optional — model used for the verification pass on OpenAI. Same
# reasoning as GOOGLE_VERIFY_MODEL above; defaults to gpt-4o-mini.
# OPENAI_VERIFY_MODEL="gpt-4o-mini"

# Optional — per-user monthly USD cap for /api/extract. Defaults to $2.00.
# Once a user's MTD spend (from the aiUsage ledger) hits this value the
# endpoint returns a friendly 402. At ~⅔ of the cap, image extraction is
# silently downgraded to gpt-4o-mini so the user can keep using the app.
# Set to "0" or "none" to disable capping (e.g. trusted single-user setups).
# POTLUCK_USER_MONTHLY_USD_CAP="2.00"

# Optional — set when running behind a reverse proxy (Cloudflare Tunnel,
# ngrok, etc.) so Auth.js builds OAuth callback URLs against the proxy
# hostname instead of localhost:3000.
# AUTH_TRUST_HOST="true"
# AUTH_URL="https://your-tunnel.trycloudflare.com"

# Optional — when set, ONLY these email addresses can sign in. Comma- or
# whitespace-separated, case-insensitive. Leave unset for open registration.
# Use this on private deployments (e.g. family-only home server).
# POTLUCK_ALLOWED_EMAILS="me@gmail.com,wife@gmail.com,brother@gmail.com"

# Optional — defaults to ./data. On a server you usually want this to
# live outside the git checkout so deploys can't clobber it.
# POTLUCK_DATA_DIR="/var/lib/potluck"

# Optional — Web Push (notifies recipe authors on comments / ratings /
# saves). Generate keys with: pnpm push:keys
# When unset, push is silently disabled (the "Enable notifications" menu
# item hides itself, server-side notify calls become no-ops).
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
