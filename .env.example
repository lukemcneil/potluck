# Copy to .env.local and fill in. .env.local is gitignored.

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI — used for photo -> structured recipe extraction (gpt-4o vision)
OPENAI_API_KEY=""

# Optional — set when running behind a reverse proxy (Cloudflare Tunnel,
# ngrok, etc.) so Auth.js builds OAuth callback URLs against the proxy
# hostname instead of localhost:3000.
# AUTH_TRUST_HOST="true"
# AUTH_URL="https://your-tunnel.trycloudflare.com"

# Optional — defaults to ./data
# POTLUCK_DATA_DIR="./data"
